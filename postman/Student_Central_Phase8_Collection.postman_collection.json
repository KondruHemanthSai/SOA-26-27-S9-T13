		{
			"name": "12. Security: Student Forbidden from Admin Create",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{studentToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": \"user-102\",\n    \"title\": \"Unauthorized Direct Alert\",\n    \"message\": \"Student should not be able to trigger this.\",\n    \"type\": \"SYSTEM\",\n    \"priority\": \"NORMAL\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/notifications",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Student receives 403 Forbidden', function () {",
							"    pm.response.to.have.status(403);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "13. Validation: Reject Notification with Missing Title",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{adminToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": \"user-102\",\n    \"message\": \"Message without title\",\n    \"type\": \"SYSTEM\",\n    \"priority\": \"NORMAL\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/notifications",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Validation rejects with 400 Bad Request', function () {",
							"    pm.response.to.have.status(400);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
