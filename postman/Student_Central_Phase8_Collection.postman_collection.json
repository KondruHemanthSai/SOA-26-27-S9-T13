{
	"info": {
		"_postman_id": "8a9123fa-4321-4f1b-b492-9b81fa321008",
		"name": "Student Central - Phase 8: Notification Service",
		"description": "Postman API Collection for Student Central Phase 8: Notification Service. Covers In-App notifications, student notification feeds (paginated & unread), read/unread management, bulk read-all, individual deletion, admin direct notification creation, admin broadcast notifications, internal service-to-service alerts, and RBAC / security validation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "directUrl",
			"value": "http://localhost:8087",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "studentToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "studentUserId",
			"value": "user-101",
			"type": "string"
		},
		{
			"key": "notificationId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01. Service Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/notifications/health",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications", "health"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Health status is UP', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('UP');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "02. Auth: Login as Admin",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@campus.local\",\n    \"password\": \"Admin@123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Admin login successful', function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    var token = jsonData.token || (jsonData.data && jsonData.data.token);",
							"    pm.collectionVariables.set('adminToken', token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "03. Auth: Login as Student",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"student@campus.local\",\n    \"password\": \"Student@123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Student login successful', function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    var token = jsonData.token || (jsonData.data && jsonData.data.token);",
							"    pm.collectionVariables.set('studentToken', token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "04. Admin: Create Direct Notification",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{adminToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": \"{{studentUserId}}\",\n    \"title\": \"Admission Verification Notice\",\n    \"message\": \"Your submitted identity documents have been verified by the Admission Office.\",\n    \"type\": \"ADMISSION\",\n    \"priority\": \"HIGH\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/notifications",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Notification created with 201', function () {",
							"    pm.response.to.have.status(201);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data.notificationId).to.exist;",
							"    pm.collectionVariables.set('notificationId', jsonData.data.notificationId);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "05. Admin: Broadcast Announcement",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{adminToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userIds\": [\"{{studentUserId}}\", \"user-102\", \"user-103\"],\n    \"title\": \"Spring Semester Registration Opening\",\n    \"message\": \"Course registration portal opens tomorrow at 09:00 AM.\",\n    \"type\": \"ANNOUNCEMENT\",\n    \"priority\": \"NORMAL\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/notifications/broadcast",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications", "broadcast"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Broadcast sent with 201', function () {",
							"    pm.response.to.have.status(201);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "06. Student: Get My Notifications (Paginated)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{studentToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/notifications/my?page=0&size=10",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications", "my"],
					"query": [
						{
							"key": "page",
							"value": "0"
						},
						{
							"key": "size",
							"value": "10"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data.content).to.be.an('array');",
							"    pm.expect(jsonData.data.pageSize).to.eql(10);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "07. Student: Get My Unread Notifications",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{studentToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/notifications/my/unread",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications", "my", "unread"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 200 and items unread', function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"    jsonData.data.forEach(function(item) {",
							"        pm.expect(item.read).to.be.false;",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "08. Student: Get Unread Count",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{studentToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/notifications/my/unread-count",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications", "my", "unread-count"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Unread count is greater than zero', function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.unreadCount).to.be.at.least(1);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
