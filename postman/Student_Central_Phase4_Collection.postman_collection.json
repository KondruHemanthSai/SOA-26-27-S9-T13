  "item": [
    {
      "name": "1. Student Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob Smith\",\n  \"email\": \"bob.smith@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "2. Student Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('studentToken', jsonData.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob.smith@example.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "3. Create Admission Application (Draft)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('createdApplicationId', jsonData.applicationId);",
              "pm.expect(jsonData.status).to.eql('DRAFT');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"program\": \"B.Tech Computer Science\",\n  \"department\": \"Computer Science\",\n  \"academicDetails\": {\n    \"previousInstitution\": \"Oakridge High\",\n    \"board\": \"CBSE\",\n    \"percentage\": 91.5,\n    \"cgpa\": 9.1,\n    \"graduationYear\": 2023\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admissions/apply",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admissions",
            "apply"
          ]
        }
      }
    },
