{
  "info": {
    "name": "Student Central - Phase 4 Admission Service Collection",
    "_postman_id": "9a6b1284-4d89-4991-88f2-1a48c9032fa8",
    "description": "Postman test collection for Phase 4: Admission Application, Document Metadata & Admin Review Workflow through API Gateway (Port 8080).",
